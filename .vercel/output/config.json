{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/api/chat/?(?:/__data.json)?$",
			"dest": "/api/chat"
		},
		{
			"src": "^/api/chat/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/chat/[id]"
		},
		{
			"src": "^/api/front-history/?(?:/__data.json)?$",
			"dest": "/api/front-history"
		},
		{
			"src": "^/api/front-history/current/?(?:/__data.json)?$",
			"dest": "/api/front-history/current"
		},
		{
			"src": "^/api/front-history/member/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/front-history/member/[id]"
		},
		{
			"src": "^/api/front-history/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/front-history/[id]"
		},
		{
			"src": "^/api/health/db/?(?:/__data.json)?$",
			"dest": "/api/health/db"
		},
		{
			"src": "^/api/health/storage/?(?:/__data.json)?$",
			"dest": "/api/health/storage"
		},
		{
			"src": "^/api/import/?(?:/__data.json)?$",
			"dest": "/api/import"
		},
		{
			"src": "^/api/journal/?(?:/__data.json)?$",
			"dest": "/api/journal"
		},
		{
			"src": "^/api/journal/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/journal/[id]"
		},
		{
			"src": "^/api/journal/([^/]+?)/pin/?(?:/__data.json)?$",
			"dest": "/api/journal/[id]/pin"
		},
		{
			"src": "^/api/media/members/([^/]+?)/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/media/members/[memberID]/[kind]"
		},
		{
			"src": "^/api/members/?(?:/__data.json)?$",
			"dest": "/api/members"
		},
		{
			"src": "^/api/members/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/api/members/[id]"
		},
		{
			"src": "^/api/members/([^/]+?)/fronting/?(?:/__data.json)?$",
			"dest": "/api/members/[id]/fronting"
		},
		{
			"src": "^/chat/?(?:/__data.json)?$",
			"dest": "/chat"
		},
		{
			"src": "^/customize/?(?:/__data.json)?$",
			"dest": "/customize"
		},
		{
			"src": "^/front/?(?:/__data.json)?$",
			"dest": "/front"
		},
		{
			"src": "^/import/?(?:/__data.json)?$",
			"dest": "/import"
		},
		{
			"src": "^/journal/?(?:/__data.json)?$",
			"dest": "/journal"
		},
		{
			"src": "^/journal/new/?(?:/__data.json)?$",
			"dest": "/journal/new"
		},
		{
			"src": "^/journal/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/journal/[entry]"
		},
		{
			"src": "^/members/?(?:/__data.json)?$",
			"dest": "/members"
		},
		{
			"src": "^/members/edit/?(?:/__data.json)?$",
			"dest": "/members/edit"
		},
		{
			"src": "^/members/new/?(?:/__data.json)?$",
			"dest": "/members/new"
		},
		{
			"src": "^/members/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/members/[member]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}